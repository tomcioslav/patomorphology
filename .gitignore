# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# uv
.uv-cache/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Notebooks
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Data — versioned datasets do not belong in git.
# Track structure (and per-dataset READMEs) only.
data/*
!data/.gitkeep
!data/README.md
!data/raw/
data/raw/*
!data/raw/*/
data/raw/*/*
!data/raw/*/README.md

# Model artifacts
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.pkl
*.joblib

# Lightning training runs (legacy default location, no longer used)
lightning_logs/

# Per-run training outputs — track structure (README + .gitkeep) but not
# contents. Hydra's per-job dir IS the run dir (see conf/config.yaml's
# hydra.run.dir / hydra.sweep block), so `.hydra/` + `train.log` land here
# too — no separate outputs/ tree.
runs/*
!runs/.gitkeep
!runs/README.md

# IDEs / OS
.idea/
.vscode/*
!.vscode/settings.json
.DS_Store
Thumbs.db

# Secrets / env
.env
.env.*
!.env.example
